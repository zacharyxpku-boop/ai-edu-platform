{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/:page(tutor|mastery-loop|parent-radar|parent-report|mentor|welcome|admin|tools|assistant|about|paths|question-bank|quiz)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/src/api-manager.js",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [],
  "redirects": [
    { "source": "/methods", "destination": "/assistant", "permanent": true },
    { "source": "/methods.html", "destination": "/assistant", "permanent": true },
    { "source": "/about-brand", "destination": "/about", "permanent": true },
    { "source": "/about-brand.html", "destination": "/about", "permanent": true },
    { "source": "/scoring-breakdown", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/tools/scoring-breakdown", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/tools/scoring-breakdown.html", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/start", "destination": "/mastery-loop", "permanent": false },
    { "source": "/radar", "destination": "/parent-radar", "permanent": false },
    { "source": "/report", "destination": "/parent-report", "permanent": false }
  ]
}
