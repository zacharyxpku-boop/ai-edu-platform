{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=60, stale-while-revalidate=120" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/app",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/src/api-manager.js",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/mini/session", "destination": "/api/mini-dispatch?endpoint=session" },
    { "source": "/api/mini/priority", "destination": "/api/mini-dispatch?endpoint=priority" },
    { "source": "/api/mini/content-check", "destination": "/api/mini-dispatch?endpoint=content-check" },
    { "source": "/api/mini/weekly", "destination": "/api/mini-dispatch?endpoint=weekly" },
    { "source": "/api/mini/material-image", "destination": "/api/mini-dispatch?endpoint=material-image" },
    { "source": "/api/mini/quiz-generate", "destination": "/api/mini-dispatch?endpoint=quiz-generate" },
    { "source": "/api/mini/review-today", "destination": "/api/mini-dispatch?endpoint=review-today" },
    { "source": "/api/mini/content-engine", "destination": "/api/mini-dispatch?endpoint=content-engine" },
    { "source": "/api/mini/sync", "destination": "/api/mini-dispatch?endpoint=sync" },
    { "source": "/api/mini/me", "destination": "/api/mini-dispatch?endpoint=me" },
    { "source": "/api/mini/profile/children", "destination": "/api/mini-dispatch?endpoint=profile-children" },
    { "source": "/api/mini/role/switch", "destination": "/api/mini-dispatch?endpoint=role-switch" },
    { "source": "/api/mini/event", "destination": "/api/mini-dispatch?endpoint=event" },
    { "source": "/api/mini/student/:id/timeline", "destination": "/api/mini-dispatch?endpoint=student-timeline&id=:id" },
    { "source": "/api/mini/student/:id/portrait", "destination": "/api/mini-dispatch?endpoint=student-portrait&id=:id" },
    { "source": "/api/mini/knowledge-map", "destination": "/api/mini-dispatch?endpoint=knowledge-map" },
    { "source": "/api/mini/subscription/reminder", "destination": "/api/mini-dispatch?endpoint=subscription-reminder" },
    { "source": "/api/mini/billing/plans", "destination": "/api/mini-dispatch?endpoint=billing-plans" },
    { "source": "/api/mini/billing/order", "destination": "/api/mini-dispatch?endpoint=billing-order" },
    { "source": "/api/mini/billing/quota", "destination": "/api/mini-dispatch?endpoint=billing-quota" },
    { "source": "/api/pay/wechat/notify", "destination": "/api/mini-dispatch?endpoint=pay-wechat-notify" },
    { "source": "/api/mini/legal/privacy", "destination": "/api/mini-dispatch?endpoint=privacy" },
    { "source": "/api/mini/account/delete-request", "destination": "/api/mini-dispatch?endpoint=account-delete-request" },
    { "source": "/api/mini/data/export", "destination": "/api/mini-dispatch?endpoint=data-export" },
    { "source": "/api/admin/users", "destination": "/api/mini-dispatch?endpoint=admin-users" },
    { "source": "/api/admin/reports", "destination": "/api/mini-dispatch?endpoint=admin-reports" },
    { "source": "/api/admin/conversations", "destination": "/api/mini-dispatch?endpoint=admin-conversations" },
    { "source": "/api/admin/ai-traces", "destination": "/api/mini-dispatch?endpoint=admin-ai-traces" },
