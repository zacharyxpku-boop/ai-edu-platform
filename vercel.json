    { "source": "/api/mini/review-grade", "destination": "/api/mini-dispatch?endpoint=review-grade" },
    { "source": "/api/mini/quiz-submit", "destination": "/api/mini-dispatch?endpoint=quiz-submit" },
    { "source": "/api/mini/report", "destination": "/api/mini-dispatch?endpoint=report" },
    { "source": "/api/mini/learning-report-recognize", "destination": "/api/mini-dispatch?endpoint=learning-report-recognize" },
    { "source": "/api/lead", "destination": "/api/mini-dispatch?endpoint=lead" },
    { "source": "/api/tutor-chat", "destination": "/api/retired?endpoint=tutor-chat" },
    { "source": "/api/achievement-quote", "destination": "/api/retired?endpoint=achievement-quote" },
    { "source": "/api/leaderboard", "destination": "/api/retired?endpoint=leaderboard" },
    { "source": "/api/achievements", "destination": "/api/retired?endpoint=achievements" },
    { "source": "/api/shop/items", "destination": "/api/retired?endpoint=shop/items" },
    { "source": "/api/shop/purchase", "destination": "/api/retired?endpoint=shop/purchase" },
    { "source": "/api/mini/shop", "destination": "/api/retired?endpoint=mini/shop" },
    { "source": "/api/mini/leaderboard", "destination": "/api/retired?endpoint=mini/leaderboard" },
    { "source": "/api/mini/achievements", "destination": "/api/retired?endpoint=mini/achievements" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/", "destination": "/app/index.html" }
  ],
  "redirects": [
    { "source": "/:page(tutor|mastery-loop|parent-radar|parent-report|mentor|welcome|admin|tools|assistant|paths|question-bank|quiz|app-lite|diagnose|learning-pack|membership|study-tools|tools-guide|warm-focus-v1|weekly|progress|platform|methods|methodology|demo)", "destination": "/app", "permanent": false },
    { "source": "/:page(tutor|mastery-loop|parent-radar|parent-report|mentor|welcome|admin|tools|assistant|paths|question-bank|quiz|app-lite|diagnose|learning-pack|membership|study-tools|tools-guide|warm-focus-v1|weekly|progress|platform|methods|methodology|demo).html", "destination": "/app", "permanent": false },
    { "source": "/about-brand", "destination": "/about", "permanent": true },
    { "source": "/about-brand.html", "destination": "/about", "permanent": true },
    { "source": "/scoring-breakdown", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/tools/scoring-breakdown", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/tools/scoring-breakdown.html", "destination": "/tools/exam-diagnosis", "permanent": true },
    { "source": "/start", "destination": "/app", "permanent": false },
    { "source": "/radar", "destination": "/app", "permanent": false },
    { "source": "/report", "destination": "/app", "permanent": false },
    { "source": "/report.html", "destination": "/app", "permanent": false }
  ]
}
