# NCDM 离线服务环境变量
# 复制为 .env（local）或在 Fly.io secrets 设置

# Supabase Postgres 连接串（Connection Pooler URL，端口 6543）
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# 训练参数
EPOCHS=50

# 输出目录（容器内）
OUT_DIR=/data/parquet

# CORS 允许的前端域名（逗号分隔）
CORS_ORIGINS=https://www.0dianxue.com,https://0dianxue.com,http://localhost:8080

# FastAPI 端口
PORT=8000
