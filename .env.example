# 原点 AI 私教 · 全栈环境变量
# 复制为 .env.local 本地用，生产环境在 Vercel Dashboard → Project Settings → Environment Variables 配
#
# ⚠️ 安全护栏：
#   · *_SERVICE_ROLE_KEY / DEEPSEEK_KEY / QWEN_KEY 永远不能 push 到 git
#   · ADMIN_TOKEN 用 `openssl rand -hex 16` 生成，存 1Password
#   · SUPABASE_ANON_KEY 公开没事（前端需要用），但必须配合 RLS 策略
#   · CONFUCIUS_HOST 仅 V2 自部署 Confucius3-Math 后才用

# ============================================================
# LLM 模型层（必填 1 个，建议两个都配做 fallback）
# ============================================================

# 通义千问 dashscope（embedding + Qwen-Plus / Qwen-Math / Qwen-Turbo）
# 获取：https://dashscope.console.aliyun.com/apiKey
QWEN_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek（主力，中文数理强）
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Confucius3-Math vLLM endpoint（V2 自部署后填，PoC 期不配）
# 形如 https://confucius-math.fly.dev
CONFUCIUS_HOST=

# ============================================================
# Supabase 数据底座（必填）
# ============================================================

# Supabase 项目 URL（公开值，前后端都用）
# 获取：Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# anon public key（前端可见，靠 RLS 限制权限）
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxx

# service_role secret key（绕过 RLS，仅 Edge Function server side 用）
# 永远不能漏到前端 / git / 群里
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxx

# ============================================================
# 运维（admin 看板 / 信号抽取 cron）
# ============================================================

# admin.html 访问令牌 + cron endpoint 鉴权
# 生成：openssl rand -hex 16
ADMIN_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# 后端服务（NCDM 学生建模训练 + 推理）
# ============================================================

# NCDM 服务地址（部署在 Fly.io 香港）
# 形如 https://yuandian-ncdm.fly.dev
# 没部时留空，mastery-proxy 会 503 但前端有 mock 兜底
NCDM_HOST=

# ============================================================
# 营销侧（既有）
# ============================================================

# 飞书 Lead Webhook（留资通知，可选）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ============================================================
# 微信小程序（可选，MVP 可先 touristappid 本地调试）
# ============================================================

# 微信公众平台 -> 小程序 -> 开发管理 -> 开发设置
WECHAT_APP_ID=wx_xxxxxxxxxxxxxxxx
WECHAT_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 用于签发小程序侧 session，生产环境必须单独生成，不要复用 AppSecret
MINI_SESSION_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# CI / GitHub Actions（cron 用，跟 Vercel env 不重合）
# ============================================================

# GitHub Actions secrets 需要配：
#   PROD_HOST           生产域名（如 https://www.0dianxue.com）
#   ADMIN_TOKEN         同上
# Vercel 不需要这两个
