.tutor-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(190rpx + env(safe-area-inset-bottom));
  background: #FAF7F0;
}

.scope {
  padding: 28rpx;
}

.clear-btn {
  color: #8A8377;
  font-size: 24rpx;
  font-weight: 800;
}

.scope-copy {
  margin-top: 14rpx;
}

.selected {
  margin-top: 20rpx;
  padding: 18rpx;
  background: #F5E8DF;
  border-radius: 14rpx;
}

.selected-text {
  margin-top: 6rpx;
  color: #8B3A1F;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.quick-btn {
  margin-top: 20rpx;
}

.chat {
  height: calc(100vh - 560rpx);
  min-height: 420rpx;
  margin-top: 22rpx;
}

.message {
  display: flex;
  margin-bottom: 18rpx;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  padding: 22rpx 24rpx;
  color: #1A1A1A;
  background: #FFFFFF;
  border: 1rpx solid #E8E1D5;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.message.user .bubble {
  color: #FFFDF8;
  background: #0F4F3D;
  border-color: #0F4F3D;
}

.composer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  align-items: flex-end;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #FFFDF8;
  border-top: 1rpx solid #E8E1D5;
}

.composer-input {
  flex: 1;
  height: 98rpx;
  max-height: 160rpx;
  padding: 20rpx 22rpx;
  background: #F7F1E8;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.45;
}

.send-btn {
  width: 126rpx;
  height: 98rpx;
  color: #FFFDF8;
  background: #0F4F3D;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 900;
}
