<view class="tutor-page safe-bottom">
  <view class="scope panel">
    <view class="between">
      <view>
        <view class="eyebrow">YUAN XIAODIAN</view>
        <view class="title-lg">只带必须做，不替写答案。</view>
      </view>
      <button class="clear-btn" bindtap="clearChat">清空</button>
    </view>

    <view class="body scope-copy">原小点只处理必须做任务和关键错因，先问思路，再给最小提示。</view>

    <view class="thinking-receipt" wx:if="{{thinkingReceipt}}">
      <view class="receipt-head">
        <view>
          <view class="answer-label">THINKING RECEIPT</view>
          <view class="receipt-label">{{thinkingReceipt.label}}</view>
        </view>
        <view class="receipt-score">{{thinkingReceipt.score}}</view>
      </view>
      <view class="receipt-focus">{{thinkingReceipt.focus}}</view>
      <view class="receipt-status">{{thinkingReceipt.status}}</view>
      <view class="receipt-grid">
        <view class="receipt-check {{item.done ? 'done' : ''}}" wx:for="{{thinkingReceipt.checks}}" wx:key="id">
          <view class="receipt-check-label">{{item.label}}</view>
          <view class="muted">{{item.detail}}</view>
        </view>
      </view>
      <view class="receipt-share">{{thinkingReceipt.shareLine}}</view>
    </view>

    <view class="coach-console" wx:if="{{coachConsole}}">
      <view class="answer-label">SOCRATIC COACH CONSOLE</view>
      <view class="coach-console-label">{{coachConsole.label}}</view>
      <view class="coach-console-main">
        <view>
          <view class="console-kicker">Focus</view>
          <view class="console-focus">{{coachConsole.focus}}</view>
        </view>
        <view class="console-risk">{{coachConsole.risk}}</view>
      </view>
      <view class="console-grid">
        <view class="console-cell">
          <view class="console-kicker">Wrong cause</view>
          <view class="console-value">{{coachConsole.wrongCause}}</view>
        </view>
        <view class="console-cell">
          <view class="console-kicker">Now</view>
          <view class="console-value">{{coachConsole.currentAction}}</view>
          <view class="muted">{{coachConsole.actionDesc}}</view>
        </view>
        <view class="console-cell">
          <view class="console-kicker">Mastery</view>
          <view class="console-value">{{coachConsole.masteryStatus}}</view>
        </view>
        <view class="console-cell">
          <view class="console-kicker">Evidence</view>
          <view class="console-value">{{coachConsole.evidence}}</view>
        </view>
      </view>
      <view class="console-flow">
        <view class="console-flow-card" wx:for="{{coachConsole.cards}}" wx:key="id">
          <view class="console-flow-title">{{item.title}}</view>
          <view class="muted">{{item.body}}</view>
        </view>
      </view>
    </view>

    <view class="selected" wx:if="{{selected}}">
      <view class="selected-head">
        <view>
          <view class="muted">当前锁定</view>
          <view class="selected-text">{{selected.text}}</view>
        </view>
        <button class="secondary-button quick-btn-inline" bindtap="quickStart">重新锁定</button>
      </view>

      <view class="selected-reason" wx:if="{{selected.reason}}">{{selected.reason}}</view>

      <view class="signal-row" wx:if="{{selectedEvidence && selectedEvidence.weak_point}}">
        <view class="signal-chip">弱点：{{selectedEvidence.weak_point.name}}</view>
        <view class="signal-chip" wx:if="{{selectedEvidence.calibration_key}}">校准键：{{selectedEvidence.calibration_key}}</view>
      </view>

      <view class="tag-row" wx:if="{{misconceptionTags.length}}">
        <view class="tag-chip" wx:for="{{misconceptionTags}}" wx:key="index">{{item.label || item.axis}}</view>
      </view>
    </view>

    <button class="secondary-button quick-btn" bindtap="quickStart">锁定第一项必须做</button>
  </view>

  <view class="coach-bar panel">
    <view class="pedagogy-panel" wx:if="{{pedagogy}}">
      <view class="answer-label">TUTOR PEDAGOGY LAYER</view>
      <view class="body">{{pedagogy.label}}</view>
      <view class="pedagogy-grid">
        <view class="pedagogy-card" wx:for="{{pedagogy.ladder}}" wx:key="id">
          <view class="pedagogy-title">{{item.title}}</view>
          <view class="muted">{{item.desc}}</view>
        </view>
      </view>
      <view class="guardrail-row">
        <view class="guardrail-pill" wx:for="{{pedagogy.guardrails}}" wx:key="*this">{{item}}</view>
      </view>
      <view class="teacher-view">{{pedagogy.teacherView}}</view>
    </view>
    <view class="pedagogy-panel risk-panel" wx:if="{{pasteRisk}}">
      <view class="answer-label">COPY-PASTE RISK GATE</view>
      <view class="body">{{pasteRisk.label}}</view>
      <view class="risk-level">{{pasteRisk.level}}</view>
    </view>
    <view class="coach-head">
      <view class="coach-title">掌握循环</view>
      <view class="coach-step">{{coachStepLabel}}</view>
    </view>
    <scroll-view class="step-scroll" scroll-x enable-flex>
      <view class="step-row">
        <button
          wx:for="{{quickActions}}"
          wx:key="id"
          class="step-btn {{activeStep === item.id ? 'step-btn-active' : ''}}"
          data-step="{{item.id}}"
          bindtap="pickStep"
        >{{item.label}}</button>
      </view>
    </scroll-view>
    <view class="next-action">下一步：{{nextAction}}</view>
    <view class="mastery-box" wx:if="{{masterySignal}}">
      <view class="mastery-status">{{masterySignal.status}}</view>
      <view class="mastery-text">{{masterySignal.evidence_needed}}</view>
    </view>
    <view class="quick-row">
      <button
        wx:for="{{quickActions}}"
        wx:key="id"
        class="ghost-btn"
        data-step="{{item.id}}"
        bindtap="sendQuick"
      >
        <view class="ghost-title">{{item.label}}</view>
        <view class="ghost-desc">{{item.desc}}</view>
      </button>
    </view>
  </view>

  <scroll-view class="chat" scroll-y>
    <view class="message {{item.role}}" wx:for="{{messages}}" wx:key="index">
      <view class="bubble">{{item.text}}</view>
    </view>
    <view class="message assistant" wx:if="{{loading}}">
      <view class="bubble">我在拆关键错因，先等我一句。</view>
    </view>
  </scroll-view>

  <view class="composer">
    <textarea class="composer-input" value="{{input}}" bindinput="onInput" placeholder="贴题目、步骤或作业项。不要只发“给答案”。" />
    <button class="send-btn" bindtap="send">发送</button>
  </view>
</view>
