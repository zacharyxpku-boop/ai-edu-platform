<view class="page safe-bottom profile-page">
  <scroll-view class="profile-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="profile-shell">
      <view class="ux-entry ux-entry-parent ux-kit-screen ux-kit-parent yd-parent-screen">
        <view class="yd-parent-top">
          <view class="yd-parent-brand">
            <image class="yd-parent-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
            <view>
              <text>原点智学</text>
              <text>证据与下一步</text>
            </view>
          </view>
          <view class="yd-parent-pill">5 秒看懂</view>
        </view>
        <view class="yd-parent-hero">
          <view class="yd-parent-copy">
            <view class="yd-parent-kicker">今晚不用盯全程</view>
            <view class="yd-parent-title">{{profileViewModel.title}}</view>
            <view class="yd-parent-title">只看孩子有没有走出第一步</view>
            <view class="yd-parent-sub">把测评、成绩、错题和复习回访合成一张家长行动卡：先看证据，再问一句，明天再验证。</view>
          </view>
          <image class="yd-parent-art" mode="aspectFill" src="/assets/reference/entry-parent.png" />
        </view>
        <view class="yd-parent-proof-grid">
          <view class="yd-parent-proof primary"><text>今晚结论</text><text>先稳住一个真实卡点</text></view>
          <view class="yd-parent-proof"><text>第一步证据</text><text>孩子能说出从哪看起</text></view>
          <view class="yd-parent-proof"><text>明天回访</text><text>用 90 秒复述验证</text></view>
        </view>
        <view class="yd-parent-evidence">
          <view class="yd-parent-section-head">
            <text>证据来源</text>
            <text>不靠感觉判断</text>
          </view>
          <view class="parent-report-preview" data-scene="parent" bindtap="openEntryDetail">
            <image class="parent-report-thumb" mode="aspectFill" src="/assets/reference/entry-report.png" />
            <view class="parent-report-copy">
              <text>个性化报告预览</text>
              <text>把天赋画像、成绩波动、错题卡点合成一张家长能看懂的下一步。</text>
            </view>
            <view class="parent-report-badge">查看</view>
          </view>
          <view class="yd-parent-evidence-grid">
            <view><text>测评报告</text><text>天赋画像</text></view>
            <view><text>成绩单</text><text>科目波动</text></view>
            <view><text>错题</text><text>真实卡点</text></view>
            <view><text>下一证据</text><text>回访验证方法有效性</text></view>
          </view>
        </view>
        <view class="ux-kit-jump-grid">
          <view class="ux-kit-jump-card primary parent-jump-card" data-scene="parent" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-parent.png" />
            <text>今晚安排</text>
            <text>看行动卡</text>
          </view>
          <view class="ux-kit-jump-card parent-jump-card" data-scene="upload" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-upload.png" />
            <text>补充材料</text>
            <text>上传新证据</text>
          </view>
          <view class="ux-kit-jump-card parent-jump-card" data-scene="review" bindtap="openEntryDetail">
            <image mode="aspectFill" src="/assets/reference/entry-review.png" />
            <text>复习回访</text>
            <text>验证是否迁移</text>
          </view>
        </view>
        <view class="yd-parent-route">
          <view class="parent-route-node active">
            <image class="parent-route-icon" mode="aspectFit" src="/assets/reference/entry-upload.png" />
            <text>上传</text>
            <text>证据进来</text>
          </view>
          <view class="parent-route-node active">
            <image class="parent-route-icon" mode="aspectFit" src="/assets/reference/entry-report.png" />
            <text>分析</text>
            <text>看方法匹配</text>
          </view>
          <view class="parent-route-node">
            <image class="parent-route-icon" mode="aspectFit" src="/assets/reference/entry-review.png" />
            <text>回访</text>
            <text>验证迁移</text>
          </view>
          <view class="parent-route-node final">
            <image class="parent-route-icon" mode="aspectFit" src="/assets/reference/entry-parent.png" />
            <text>周报</text>
            <text>家长看下一步</text>
          </view>
        </view>
        <view class="yd-parent-action-row">
          <view class="ux-kit-primary parent-primary" data-scene="parent" bindtap="openEntryDetail">{{profileViewModel.primaryCta}}</view>
          <view class="ux-kit-secondary parent-secondary" data-scene="upload" bindtap="openEntryDetail">补一份材料</view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
