.parent-report {
  border-color: #BFD7CC;
  background: linear-gradient(180deg, #FFFDF8 0%, #F4FAF6 100%);
}

.parent-report-head {
  align-items: flex-start;
  gap: 20rpx;
}

.parent-score {
  flex: 0 0 auto;
  width: 112rpx;
  min-height: 112rpx;
  padding-top: 16rpx;
  background: #0F4F3D;
  border-radius: 14rpx;
  color: #FFFDF8;
  text-align: center;
}

.parent-score-num {
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.parent-score-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  opacity: 0.78;
}

.parent-highlight {
  margin-top: 20rpx;
  padding: 18rpx;
  background: rgba(15, 79, 61, 0.08);
  border-left: 6rpx solid #0F4F3D;
  border-radius: 10rpx;
  color: #213D33;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.parent-moat {
  background: #FFFBF2;
  border-left-color: #B87924;
  color: #5D421A;
}

.proof-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.proof-card {
  min-width: 0;
  padding: 18rpx;
  background: #FFFDF8;
  border: 1rpx solid #D8E6DE;
  border-radius: 12rpx;
}

.proof-value {
  color: #0F4F3D;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1;
}

.proof-label {
  margin-top: 10rpx;
  color: #1A1A1A;
  font-size: 24rpx;
  font-weight: 900;
}

.proof-note {
  margin-top: 8rpx;
  color: #625B50;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.4;
}

.parent-subtitle {
  margin-top: 22rpx;
  color: #0F4F3D;
  font-weight: 900;
}

.asset-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 14rpx;
}

.asset-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
  padding: 16rpx;
  background: #FFFDF8;
  border: 1rpx solid #E7E0D2;
  border-radius: 10rpx;
}

.asset-label {
  flex: 0 0 190rpx;
  color: #625B50;
  font-size: 22rpx;
  font-weight: 900;
}

.asset-value {
  min-width: 0;
  color: #1A1A1A;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
  text-align: right;
}

.parent-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.action-chip {
  min-height: 94rpx;
  padding: 14rpx 10rpx;
  background: #F1F7F3;
  border: 1rpx solid #CFE0D8;
  border-radius: 12rpx;
  line-height: 1.2;
  text-align: left;
}

.action-chip-label {
  color: #0F4F3D;
  font-size: 24rpx;
  font-weight: 900;
}

.action-chip-detail {
  margin-top: 8rpx;
  color: #625B50;
  font-size: 20rpx;
  font-weight: 800;
}

.thinking-ledger {
  margin-top: 20rpx;
  padding: 18rpx;
  background: #F6FBF8;
  border: 1rpx solid #CFE0D8;
  border-radius: 14rpx;
}

.ledger-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.ledger-card {
  min-width: 0;
  padding: 16rpx 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE8E2;
  border-radius: 12rpx;
}

.ledger-value {
  color: #0F4F3D;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.ledger-label {
  margin-top: 8rpx;
  color: #625B50;
  font-size: 21rpx;
  font-weight: 800;
}

.legal-list {
  overflow: hidden;
  background: #FFFDF8;
  border: 1rpx solid #E8E1D5;
  border-radius: 16rpx;
}

.legal-item {
  display: block;
  width: 100%;
  min-height: 90rpx;
  padding: 0 28rpx;
  color: #1A1A1A;
  border-bottom: 1rpx solid #E8E1D5;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 90rpx;
  text-align: left;
}

.legal-item:last-child {
  border-bottom: 0;
}

.danger-button {
  color: #8B3A1F;
  border-color: #E7B9A2;
}

.module-summary {
  border-color: #CFE0D8;
}

.review-summary {
  border-color: #E4D2AA;
}

.module-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.module-stats.second-row {
  margin-top: 12rpx;
}

.module-stat {
  flex: 1;
  padding: 18rpx 12rpx;
  background: #F1F7F3;
  border-radius: 12rpx;
  text-align: center;
}

.module-num {
  color: #0F4F3D;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.module-label {
  margin-top: 8rpx;
  color: #625B50;
  font-size: 21rpx;
  font-weight: 800;
}

.calibration-profile {
  border-color: #E4D2AA;
}

.profile-badge {
  flex: 0 0 auto;
  padding: 10rpx 14rpx;
  background: #FFFBF2;
  border: 1rpx solid #E8D5B2;
  border-radius: 999rpx;
  color: #8B5A1F;
  font-size: 22rpx;
  font-weight: 900;
}

.calibration-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.second-calibration {
  margin-top: 12rpx;
}

.calibration-cell {
  min-width: 0;
  padding: 18rpx 10rpx;
  background: #FFFBF2;
  border: 1rpx solid #E8D5B2;
  border-radius: 12rpx;
  text-align: center;
}

.signal-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 18rpx;
}

.signal-item {
  padding: 14rpx 16rpx;
  background: #F7F1E8;
  border-left: 6rpx solid #0F4F3D;
  border-radius: 10rpx;
  color: #3D382F;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.sync-panel {
  border-color: #CFE0D8;
}

.sync-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.sync-diagnostics {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: rgba(15, 79, 61, 0.06);
}

.queue-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.queue-pill {
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #fffaf0;
  color: #625b50;
  font-size: 22rpx;
}

.sync-btn {
  flex: 1;
}

.sync-readiness {
  border-color: #E8D5B2;
}

.sync-ready-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.sync-ready-card {
  min-width: 0;
  padding: 16rpx 14rpx;
  background: #FFFBF2;
  border: 1rpx solid #E8D5B2;
  border-radius: 12rpx;
}

.sync-ready-top {
  display: flex;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.sync-ready-label {
  color: #1A1A1A;
  font-size: 23rpx;
  font-weight: 900;
}

.sync-ready-state {
  flex: 0 0 auto;
  font-size: 20rpx;
  font-weight: 900;
}

.ready-on {
  color: #0F4F3D;
}

.ready-off {
  color: #8B3A1F;
}

.sync-ready-next {
  margin-top: 14rpx;
  color: #625B50;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.45;
}

.commercial-panel {
  border-color: #D9C7F1;
  background: #FBF9FF;
}

.tier-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tier-card {
  padding: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid #E7DCF7;
  border-radius: 12rpx;
}

.tier-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.tier-name {
  color: #1A1A1A;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.35;
}

.tier-price {
  flex: 0 0 auto;
  color: #6A4BA3;
  font-size: 24rpx;
  font-weight: 900;
}

.tier-cta {
  margin-top: 10rpx;
  color: #6A4BA3;
  font-size: 21rpx;
  font-weight: 900;
}

.pilot-panel {
  border-color: #CFE0D8;
  background: #F6FBF8;
}

.pilot-evidence-panel {
  border-color: #BFD7CC;
  background: linear-gradient(180deg, #FFFDF8 0%, #F4FAF6 100%);
}

.pilot-steps {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.pilot-step {
  display: flex;
  gap: 14rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE8E2;
  border-radius: 12rpx;
}

.pilot-day {
  flex: 0 0 90rpx;
  color: #0F4F3D;
  font-size: 22rpx;
  font-weight: 900;
}

.pilot-title {
  color: #1A1A1A;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.pilot-metrics {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 16rpx;
}

.pilot-metric {
  min-width: 0;
  padding: 14rpx 10rpx;
  background: #FFFFFF;
  border: 1rpx solid #DCE8E2;
  border-radius: 10rpx;
}

.pilot-metric-value {
  color: #0F4F3D;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.1;
}

.pilot-metric-label {
  margin-top: 7rpx;
  color: #625B50;
  font-size: 19rpx;
  font-weight: 800;
  line-height: 1.25;
}

.launch-checklist {
  border-color: #E4D2AA;
  background: #FFFBF2;
}

.launch-check-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.launch-check-card {
  min-width: 0;
  padding: 16rpx 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8D5B2;
  border-radius: 12rpx;
}

.launch-check-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.launch-check-label {
  color: #1A1A1A;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.35;
}

.launch-check-state {
  flex: 0 0 auto;
  font-size: 19rpx;
  font-weight: 900;
}

.launch-check-owner {
  margin-bottom: 8rpx;
  color: #8B5A1F;
  font-size: 20rpx;
  font-weight: 900;
}

.flywheel-panel {
  border-color: #CFE0D8;
  background: #F6FBF8;
}

.benchmark-panel {
  border-color: #D9C7F1;
  background: #FBF9FF;
}

.switch-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.label {
  color: #1A1A1A;
  font-size: 22rpx;
  font-weight: 900;
}

.input {
  width: 100%;
  min-height: 76rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid #D9D1C2;
  border-radius: 12rpx;
  color: #1A1A1A;
  font-size: 24rpx;
  line-height: 76rpx;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1rpx solid #D9D1C2;
  border-radius: 12rpx;
  color: #1A1A1A;
  font-size: 24rpx;
  line-height: 1.45;
}
