page {
  background: #F9F8F4;
}

.profile-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  color: #1F2933;
  background: #F9F8F4;
}

.profile-scroll {
  position: relative;
  z-index: 2;
  height: 100vh;
}

.profile-shell {
  position: relative;
  z-index: 2;
  padding: 0 44rpx calc(170rpx + env(safe-area-inset-bottom));
}

.yd-parent-screen {
  position: relative;
  margin: 18rpx 0 26rpx;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(232, 238, 230, 0.94);
  border-radius: 36rpx;
  background:
    radial-gradient(circle at 9% 3%, rgba(248, 198, 34, 0.18), transparent 24%),
    radial-gradient(circle at 92% 12%, rgba(76, 159, 255, 0.12), transparent 22%),
    linear-gradient(180deg, #fffef9 0%, #f7fbf3 100%);
  box-shadow: 0 22rpx 60rpx rgba(38, 58, 43, 0.08);
}

.yd-parent-top,
.yd-parent-brand,
.yd-parent-hero,
.yd-parent-section-head,
.yd-parent-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.yd-parent-brand {
  min-width: 0;
  justify-content: flex-start;
}

.yd-parent-mark {
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  display: block;
  padding: 7rpx;
  border-radius: 18rpx;
  background: #ebf9ed;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  box-shadow: 0 14rpx 26rpx rgba(34, 185, 92, 0.24);
}

.yd-parent-brand text {
  display: block;
  max-width: 340rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-brand text:first-child {
  color: #18211d;
  font-size: 30rpx;
  font-weight: 950;
  line-height: 1.15;
}

.yd-parent-brand text:last-child {
  margin-top: 3rpx;
  color: #6a766f;
  font-size: 21rpx;
  font-weight: 760;
}

.yd-parent-pill {
  flex: 0 0 auto;
  padding: 13rpx 18rpx;
  color: #14854a;
  background: #ebf9ed;
  border: 1rpx solid rgba(34, 185, 92, 0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 900;
  white-space: nowrap;
}

.yd-parent-hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 172rpx;
  align-items: center;
  margin-top: 28rpx;
}

.yd-parent-kicker {
  width: max-content;
  max-width: 100%;
  padding: 9rpx 15rpx;
  border-radius: 999rpx;
  color: #9a6b00;
  background: #fff4c9;
  font-size: 21rpx;
  font-weight: 900;
}

.yd-parent-title {
  margin-top: 14rpx;
  color: #101a16;
  font-size: 42rpx;
  font-weight: 950;
  line-height: 1.09;
  letter-spacing: 0;
}

.yd-parent-sub {
  margin-top: 12rpx;
  color: #64706a;
  font-size: 23rpx;
  line-height: 1.5;
}

.yd-parent-art {
  width: 186rpx;
  height: 164rpx;
  border-radius: 34rpx;
  background: #fff1ea;
}

.yd-parent-decision,
.yd-parent-sources {
  border: 1rpx solid rgba(232, 238, 230, 0.95);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(38, 58, 43, 0.05);
}

.yd-parent-decision {
  display: grid;
  grid-template-columns: 118rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 14rpx;
  background:
    radial-gradient(circle at 88% 16%, rgba(248, 198, 34, 0.16), transparent 36%),
    linear-gradient(135deg, #f2fbef 0%, #ffffff 72%);
}

.yd-parent-decision-img {
  width: 118rpx;
  height: 90rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 22rpx;
  background: #edf8ff;
}

.yd-parent-decision-copy {
  min-width: 0;
}

.yd-parent-decision-copy text {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
}

.yd-parent-decision-copy text:first-child {
  color: #173f31;
  font-size: 24rpx;
  font-weight: 950;
  line-height: 1.18;
  white-space: nowrap;
}

.yd-parent-decision-copy text:nth-child(2) {
  display: -webkit-box;
  margin-top: 6rpx;
  color: #66756d;
  font-size: 20rpx;
  font-weight: 760;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.yd-parent-decision-badge {
  flex: 0 0 auto;
  padding: 9rpx 13rpx;
  border-radius: 999rpx;
  color: #0f7b43;
  background: #ffffff;
  border: 1rpx solid rgba(34, 185, 92, 0.18);
  font-size: 19rpx;
  font-weight: 950;
  white-space: nowrap;
}

.yd-parent-sources {
  margin-top: 14rpx;
  padding: 16rpx;
}

.yd-parent-section-head text:first-child {
  color: #18211d;
  font-size: 27rpx;
  font-weight: 950;
}

.yd-parent-section-head text:last-child {
  color: #738077;
  font-size: 20rpx;
  font-weight: 780;
  white-space: nowrap;
}

.yd-parent-screen .ux-kit-jump-grid {
  gap: 12rpx;
  margin-top: 18rpx;
}

.parent-jump-card {
  background:
    radial-gradient(circle at 82% 18%, rgba(248, 198, 34, 0.18), transparent 32%),
    #ffffff;
}

.yd-parent-source-row,
.yd-parent-loop {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}

.yd-parent-source-row view {
  min-width: 0;
  display: grid;
  justify-items: center;
  gap: 6rpx;
  padding: 12rpx 6rpx;
  border-radius: 20rpx;
  background: #f8fbf3;
}

.yd-parent-source-row image {
  width: 40rpx;
  height: 40rpx;
}

.yd-parent-source-row text,
.yd-parent-loop text {
  display: block;
  overflow: hidden;
  color: #174533;
  font-size: 20rpx;
  font-weight: 900;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.yd-parent-loop {
  padding: 12rpx;
  border-radius: 24rpx;
  background: #ecf9ed;
}

.yd-parent-loop text {
  position: relative;
  padding: 8rpx 4rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.84);
}

.yd-parent-action-row {
  margin-top: 18rpx;
}

.parent-primary,
.parent-secondary {
  flex: 1 1 0;
  margin-top: 0;
}

.profile-shell {
  padding: calc(108rpx + env(safe-area-inset-top)) 34rpx calc(138rpx + env(safe-area-inset-bottom));
}

.yd-parent-screen {
  margin-top: 0;
  padding: 18rpx;
  border-radius: 34rpx;
}
