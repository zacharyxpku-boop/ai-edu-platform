<view class="page arcade-redirect-page safe-bottom">
  <view class="ux-entry ux-kit-screen ux-kit-review yd-arcade-screen arcade-redirect-card">
    <view class="arcade-redirect-brand">
      <image class="yd-arcade-mark" mode="aspectFit" src="/assets/reference/brand-house.png" />
      <text>复习岛</text>
    </view>
    <image class="arcade-redirect-icon" mode="aspectFit" src="/assets/reference/entry-review.png" />
    <view class="arcade-redirect-title">正在进入复习岛</view>
    <view class="arcade-redirect-sub">已为你打开复习岛，继续做主动回忆和迁移验证。</view>
    <view class="ux-kit-jump-grid arcade-redirect-grid">
      <view class="ux-kit-jump-card primary arcade-jump-card arcade-redirect-jump" data-scene="review" bindtap="openEntryDetail">
        <image class="arcade-map-icon" mode="aspectFit" src="/assets/reference/entry-review.png" />
        <text>进入复习岛</text>
        <text>主动回忆和迁移验证</text>
      </view>
      <view class="ux-kit-jump-card arcade-jump-card arcade-redirect-jump" data-scene="tutor" bindtap="openEntryDetail">
        <image class="arcade-map-icon" mode="aspectFit" src="/assets/reference/entry-tutor.png" />
        <text>回到AI私教</text>
        <text>卡住先说第一步</text>
      </view>
      <view class="ux-kit-jump-card arcade-jump-card arcade-redirect-jump" data-scene="parent" bindtap="openEntryDetail">
        <image class="arcade-map-icon" mode="aspectFit" src="/assets/reference/entry-parent.png" />
        <text>给家长看</text>
        <text>只看证据和下一步</text>
      </view>
      <view class="arcade-redirect-jump muted" data-scene="today" bindtap="openEntryDetail">
        <image class="arcade-map-icon" mode="aspectFit" src="/assets/reference/entry-map.png" />
        <text>看今晚路径</text>
        <text>回到完整闭环</text>
      </view>
    </view>
    <button class="arcade-redirect-button" bindtap="goReview">直接进入复习岛</button>
  </view>
</view>
