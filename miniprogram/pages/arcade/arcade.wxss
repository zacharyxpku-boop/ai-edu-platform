.review-redirect-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #fffdf7 0%, #f3fbef 100%);
}

.review-redirect-card {
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 48rpx 36rpx;
  border-radius: 44rpx;
  background: #ffffff;
  border: 2rpx solid #e8eee6;
  box-shadow: 0 24rpx 60rpx rgba(41, 70, 51, 0.10);
  text-align: center;
}

.review-redirect-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #0f4f3d;
  font-size: 26rpx;
  font-weight: 900;
}

.yd-review-redirect-mark {
  width: 44rpx;
  height: 44rpx;
}

.review-redirect-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.review-redirect-jump.muted {
  background: linear-gradient(180deg, #ffffff 0%, #f3fbef 100%);
}

.review-redirect-jump {
  min-height: 188rpx;
  padding: 20rpx 12rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f7fbf3 100%);
  border: 2rpx solid #e8eee6;
}

.review-redirect-jump image {
  width: 68rpx;
  height: 68rpx;
}

.review-redirect-jump text {
  display: block;
  color: #10251c;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.35;
}

.review-redirect-jump text:last-child {
  margin-top: 6rpx;
  color: #65736a;
  font-size: 20rpx;
  font-weight: 700;
}

.review-redirect-icon {
  width: 168rpx;
  height: 168rpx;
}

.review-redirect-title {
  color: #10251c;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
}

.review-redirect-sub {
  max-width: 520rpx;
  color: #65736a;
  font-size: 28rpx;
  line-height: 1.7;
}

.review-redirect-button {
  width: 360rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #22b95c 0%, #16a34a 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 36rpx rgba(34, 185, 92, 0.22);
}

.review-redirect-button::after {
  border: 0;
}
