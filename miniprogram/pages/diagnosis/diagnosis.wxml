<view class="page safe-bottom">
  <view class="eyebrow">ASSESSMENT</view>
  <view class="title-xl">10 分钟定位弱点。</view>
  <view class="body intro">先覆盖人教版主流题型：成绩、错题描述和作业清单交叉判断。</view>

  <view class="section panel snap-panel" wx:if="{{quickSnap}}">
    <view class="between">
      <view>
        <view class="eyebrow">3-QUESTION WEAKNESS SNAP</view>
        <view class="title-md">{{quickSnap.axisName}}</view>
      </view>
      <view class="snap-score">{{quickSnap.score}}</view>
    </view>
    <view class="body">{{quickSnap.headline}}</view>
    <view class="signal-row">
      <view class="signal-pill">{{form.subject}}</view>
      <view class="signal-pill">{{form.grade}}</view>
      <view class="signal-pill">first weak guess</view>
    </view>

    <view class="field">
      <view class="label">问题 1：这道题先用到什么旧知识？</view>
      <textarea class="textarea snap-textarea" value="{{form.snapPrerequisite}}" data-field="snapPrerequisite" bindinput="onInput" placeholder="例：先要知道等量关系、单位统一、或者什么公式。" />
    </view>
    <view class="field">
      <view class="label">问题 2：如果现在开始做，第一步应该是什么？</view>
      <textarea class="textarea snap-textarea" value="{{form.snapMethod}}" data-field="snapMethod" bindinput="onInput" placeholder="例：先圈已知和未知，再写等量关系；不要直接算。" />
    </view>
    <view class="field">
      <view class="label">问题 3：如果我换一个条件，你还会做吗？</view>
      <textarea class="textarea snap-textarea" value="{{form.snapTransfer}}" data-field="snapTransfer" bindinput="onInput" placeholder="例：一变式就不会、或者能说出应该先检查什么。" />
    </view>

    <view class="snap-result">
      <view class="snap-result-title">Quick verdict</view>
      <view class="snap-result-body">{{quickSnap.nextMove}}</view>
    </view>
  </view>

  <view class="section panel stack">
    <view class="field">
      <view class="label">年级</view>
      <picker range="{{gradeOptions}}" bindchange="onGradeChange">
        <view class="picker-box">{{form.grade}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">学科</view>
      <picker range="{{subjectOptions}}" bindchange="onSubjectChange">
        <view class="picker-box">{{form.subject}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="label">本次成绩</view>
      <view class="score-row">
        <input class="input" type="number" value="{{form.score}}" data-field="score" bindinput="onInput" />
        <view class="score-sep">/</view>
        <input class="input" type="number" value="{{form.totalScore}}" data-field="totalScore" bindinput="onInput" />
      </view>
    </view>
    <view class="field">
      <view class="label">今晚可用时间</view>
      <input class="input" type="number" value="{{form.minutes}}" data-field="minutes" bindinput="onInput" />
      <view class="muted">单位：分钟。系统会按时间做取舍。</view>
    </view>
    <view class="field">
      <view class="label">错题/试卷描述</view>
      <textarea class="textarea" value="{{form.examText}}" data-field="examText" bindinput="onInput" placeholder="例：应用题读题慢，方程移项经常变号，压轴题没有思路。" />
    </view>
    <view class="field">
      <view class="label">今晚作业清单</view>
      <textarea class="textarea" value="{{form.homeworkText}}" data-field="homeworkText" bindinput="onInput" placeholder="每行一项：数学方程基础题 8 道；应用题 4 道；整理错题。" />
    </view>
  </view>

  <view class="submit-bar">
    <button class="primary-button" bindtap="submit">生成雷达与作业三分类</button>
  </view>
</view>
