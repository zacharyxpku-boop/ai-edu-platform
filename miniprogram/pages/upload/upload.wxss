.intro {
  margin-top: 20rpx;
}

.upload-playbook {
  border-color: #CFE0D8;
  background: #F5FBF8;
}

.upload-playbook-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.upload-playbook-card {
  padding: 18rpx;
  background: #FFFDF8;
  border: 1rpx solid #E8E1D5;
  border-left: 8rpx solid #0F4F3D;
  border-radius: 14rpx;
}

.upload-playbook-card.next {
  border-left-color: #8B3A1F;
}

.upload-playbook-card.moat {
  border-left-color: #6A4BA3;
}

.upload-playbook-title {
  margin-bottom: 8rpx;
  color: #1A1A1A;
  font-size: 25rpx;
  font-weight: 900;
}

.notice {
  padding: 22rpx;
  background: #F5E8DF;
  border-radius: 14rpx;
}

.notice-title {
  margin-bottom: 8rpx;
  color: #8B3A1F;
  font-weight: 900;
}

.sample-panel {
  padding: 20rpx 22rpx;
  background: #F7F1E8;
  border: 1rpx solid #E8E1D5;
  border-radius: 14rpx;
}

.sample-title {
  color: #4A463E;
  font-size: 24rpx;
  font-weight: 900;
}

.review-fill {
  width: 100%;
  min-height: 66rpx;
  margin-top: 14rpx;
  color: #8B3A1F;
  background: #FFF8F2;
  border: 1rpx solid #EBCBB7;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.sample-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.sample-chip {
  min-height: 56rpx;
  margin: 0;
  padding: 0 16rpx;
  color: #0F4F3D;
  background: #FFFFFF;
  border: 1rpx solid #D8E5DE;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 54rpx;
  text-align: left;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.material-panel {
  border-color: #CFE0D8;
  background: #F5FBF8;
}

.material-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
}

.material-tab {
  min-height: 58rpx;
  margin: 0;
  padding: 0;
  color: #625B50;
  background: #FFFDF8;
  border: 1rpx solid #E8E1D5;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.material-tab.active {
  color: #FFFDF8;
  background: #0F4F3D;
  border-color: #0F4F3D;
}

.material-textarea {
  min-height: 170rpx;
}

.material-verdict {
  margin-top: 16rpx;
  padding: 18rpx;
  background: #FFF7E9;
  border-left: 6rpx solid #B87924;
  border-radius: 12rpx;
}

.material-verdict-text {
  margin-top: 8rpx;
  color: #4A4033;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.45;
}

.material-card-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.material-card {
  padding: 14rpx 16rpx;
  background: #FFFDF8;
  border: 1rpx solid #D8E6DE;
  border-radius: 12rpx;
}

.material-card-q {
  margin-bottom: 6rpx;
  color: #1A1A1A;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.4;
}

.material-import {
  margin-top: 16rpx;
}

.preview-panel {
  border-color: #D9C7F1;
}

.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.preview-cell {
  min-width: 0;
  padding: 18rpx 10rpx;
  background: #F7F1E8;
  border: 1rpx solid #E8E1D5;
  border-radius: 14rpx;
  text-align: center;
}

.preview-cell.danger {
  background: #F5E8DF;
}

.preview-cell.quiet {
  background: #EFEAE1;
}

.preview-num {
  color: #6A4BA3;
  font-size: 32rpx;
  font-weight: 900;
}

.preview-label {
  margin-top: 8rpx;
  color: #625B50;
  font-size: 21rpx;
  font-weight: 800;
}

.preview-first {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #F5F1FF;
  border-radius: 14rpx;
}

.preview-first-title {
  margin: 8rpx 0;
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.thumb {
  width: 144rpx;
  height: 144rpx;
  border-radius: 14rpx;
  background: #EFEAE1;
}

.submit-bar {
  position: sticky;
  bottom: 24rpx;
  margin-top: 30rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
