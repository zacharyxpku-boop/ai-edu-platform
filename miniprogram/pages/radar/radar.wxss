.text-link {
  color: #0F4F3D;
  font-size: 25rpx;
  font-weight: 800;
}

.intro {
  margin-top: 18rpx;
}

.ai-note {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 14rpx;
  background: #F3EEE4;
  border: 1rpx solid #E8E1D5;
  border-radius: 10rpx;
  color: #625B50;
  font-size: 22rpx;
  line-height: 1.45;
}

.ai-note.small {
  margin-top: 16rpx;
  font-size: 20rpx;
}

.weekly-panel {
  border-color: #C9D8CE;
}

.weekly-script {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #F1F7F3;
  border-left: 6rpx solid #0F4F3D;
  border-radius: 10rpx;
  color: #163A2D;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.55;
}

.weekly-focus {
  margin-top: 18rpx;
}

.calibration-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  background: #FFFBF2;
  border: 1rpx solid #E8D5B2;
  border-radius: 12rpx;
}

.calibration-dot {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 auto;
  background: #C86D36;
  border-radius: 50%;
  box-shadow: 0 0 0 8rpx rgba(200, 109, 54, 0.12);
}

.mini-label {
  margin-bottom: 10rpx;
  color: #625B50;
  font-size: 22rpx;
  font-weight: 900;
}

.focus-item {
  margin-top: 8rpx;
  padding: 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E1D5;
  border-radius: 10rpx;
  color: #26231D;
  font-size: 24rpx;
  font-weight: 800;
}

.weak-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.weak-card {
  padding: 22rpx;
  background: #F7F1E8;
  border-radius: 14rpx;
}

.weak-name {
  font-size: 30rpx;
  font-weight: 900;
}

.reason {
  margin-top: 12rpx;
}

.radar-panel {
  overflow: hidden;
}

.radar-canvas {
  display: block;
  width: 600rpx;
  height: 600rpx;
  margin: 0 auto;
}

.axis-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.axis-item {
  color: #4A463E;
  font-size: 24rpx;
  font-weight: 700;
}

.bucket {
  padding: 28rpx;
  background: #FFFDF8;
  border: 1rpx solid #E8E1D5;
  border-radius: 16rpx;
}

.bucket-must {
  border-color: #E2B9A0;
}

.bucket-skip {
  background: #F3EEE4;
}

.bucket-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.bucket-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 22rpx;
}

.homework-item {
  padding: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E1D5;
  border-radius: 14rpx;
}

.homework-text {
  margin-bottom: 8rpx;
  color: #1A1A1A;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.45;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.e-tag {
  padding: 6rpx 10rpx;
  background: #F3EEE4;
  border-radius: 999rpx;
  color: #625B50;
  font-size: 20rpx;
  font-weight: 800;
}

.decision {
  margin-top: 10rpx;
  color: #0F4F3D;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.45;
}

.homework-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.homework-actions.compact {
  margin-top: 12rpx;
}

.mini-action {
  min-width: 96rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  background: #F3EEE4;
  border: 1rpx solid #E8E1D5;
  border-radius: 8rpx;
  color: #3D382F;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 52rpx;
}

.mini-action.primary {
  background: #0F4F3D;
  border-color: #0F4F3D;
  color: #FFFFFF;
}

.mini-action.ghost {
  background: #FFFFFF;
  color: #8A4B2F;
}

.feedback-note {
  margin-top: 10rpx;
  color: #0F4F3D;
  font-size: 22rpx;
  font-weight: 800;
}

.start-must {
  margin-top: 22rpx;
}
