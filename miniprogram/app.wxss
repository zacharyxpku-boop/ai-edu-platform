page {
  min-height: 100vh;
  color: #1A1A1A;
  background: #FAF7F0;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
picker {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
  background: transparent;
  border: 0;
  border-radius: 0;
  font: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #0F4F3D;
  font-size: 24rpx;
  font-weight: 700;
}

.title-xl {
  margin-top: 14rpx;
  color: #1A1A1A;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.08;
}

.title-lg {
  color: #1A1A1A;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.18;
}

.title-md {
  color: #1A1A1A;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.25;
}

.body {
  color: #555047;
  font-size: 27rpx;
  line-height: 1.7;
}

.muted {
  color: #8A8377;
  font-size: 24rpx;
  line-height: 1.55;
}

.section {
  margin-top: 34rpx;
}

.panel {
  padding: 30rpx;
  background: #FFFDF8;
  border: 1rpx solid #E8E1D5;
  border-radius: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(26, 26, 26, 0.045);
}

.panel-quiet {
  padding: 28rpx;
  background: #F3EEE4;
  border: 1rpx solid #E4D9C8;
  border-radius: 16rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.primary-button,
.secondary-button,
.ghost-button {
  display: flex;
  min-height: 86rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.primary-button {
  color: #FFFDF8;
  background: #0F4F3D;
}

.secondary-button {
  color: #0F4F3D;
  background: #E8EFE9;
}

.ghost-button {
  color: #1A1A1A;
  background: #FFFFFF;
  border: 1rpx solid #E4D9C8;
}

.pill {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 18rpx;
  color: #0F4F3D;
  background: #E8EFE9;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}

.pill-warm {
  color: #8B3A1F;
  background: #F5E8DF;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.label {
  color: #4A463E;
  font-size: 25rpx;
  font-weight: 800;
}

.input,
.textarea,
.picker-box {
  width: 100%;
  min-height: 84rpx;
  padding: 22rpx 24rpx;
  color: #1A1A1A;
  background: #FFFDF8;
  border: 1rpx solid #E4D9C8;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.textarea {
  min-height: 220rpx;
  line-height: 1.6;
}

.mini-card {
  padding: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E1D5;
  border-radius: 14rpx;
}

.score {
  font-family: "DIN Alternate", "SF Pro Display", sans-serif;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1;
}

.bar {
  width: 100%;
  height: 12rpx;
  overflow: hidden;
  background: #EDE5D8;
  border-radius: 999rpx;
}

.bar-fill {
  height: 100%;
  background: #0F4F3D;
  border-radius: 999rpx;
}

.bar-fill.warn {
  background: #B85C2E;
}

.divider {
  height: 1rpx;
  margin: 22rpx 0;
  background: #E8E1D5;
}

.ai-label {
  margin-top: 18rpx;
  color: #8A8377;
  font-size: 22rpx;
  line-height: 1.5;
}
